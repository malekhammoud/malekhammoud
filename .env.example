# Contact form delivery. Set ONE of these, or the form falls back to mailto:.
# INQUIRY_WEBHOOK_URL=https://…            any endpoint accepting a JSON POST
# RESEND_API_KEY=re_…
# INQUIRY_TO_EMAIL=malek@malekhammoud.com
# INQUIRY_FROM_EMAIL=site@malekhammoud.com

# IndexNow key verification (served at /<key>.txt)
# INDEXNOW_KEY=

# ── Admin (/admin) ─────────────────────────────────────────────────────────
# Password for the /admin login. Use a long random string.
# ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. Long random string.
# ADMIN_SESSION_SECRET=

# Fine-grained GitHub PAT with "Contents: read and write" on this repo only.
# Saves push a commit to the branch, which triggers the Vercel redeploy.
# ADMIN_GITHUB_TOKEN=
# ADMIN_GITHUB_OWNER=malekhammoud
# ADMIN_GITHUB_REPO=malekhammoud
# ADMIN_GITHUB_BRANCH=main

# Optional hardening
# ADMIN_LOGIN_MAX_ATTEMPTS=5
# ADMIN_LOGIN_WINDOW_MS=600000
# ADMIN_MAX_IMAGE_KB=4000
